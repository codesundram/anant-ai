// Content plane only (ARCHITECTURE.md §4). User progress — NoteCard, QuizAttempt,
// Streak, IndustryProgress — is kept on the device in Phase 1 with the same
// shapes (src/lib/progress.ts) and moves here when accounts arrive in Phase 2.
//
// SQLite has no enums or JSON columns, so those are Strings validated by the
// seed script. To move to Postgres, change `provider` and DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // native for local dev; rhel for Vercel's serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase "Transaction" pooler, port 6543) for the app.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) for schema push and seeding.
  directUrl = env("DIRECT_URL")
}

model Industry {
  id        String    @id
  slug      String    @unique
  name      String
  companies Company[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
}

model Company {
  id          String      @id
  slug        String      @unique
  name        String
  type        String // listed | startup | model
  status      String      @default("published") // draft | published
  // supplied (founder's original file) | unreviewed | approved
  review      String      @default("supplied")
  hq          String?
  leader      String?
  leaderRole  String?     @map("leader_role")
  // When the leader was last checked, e.g. "Oct 2026".
  profileAsOf String?     @map("profile_as_of")
  industryId  String      @map("industry_id")
  industry    Industry    @relation(fields: [industryId], references: [id])
  explainers  Explainer[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([industryId])
}

model Explainer {
  id          String          @id
  companyId   String          @map("company_id")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  version     Int             @default(1)
  status      String          @default("published") // draft | in_review | published
  publishedAt DateTime?       @map("published_at")
  reviewedBy  String?         @map("reviewed_by")
  note30w     String          @map("note_30w")
  parts       ExplainerPart[]
  questions   QuizQuestion[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([companyId, version])
}

model ExplainerPart {
  id          String    @id
  explainerId String    @map("explainer_id")
  explainer   Explainer @relation(fields: [explainerId], references: [id], onDelete: Cascade)
  kind        String // SELLS | EARNS | SIZE | RIVALS | WATCH
  order       Int
  body        String
  figures     Figure[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([explainerId, kind])
  @@unique([explainerId, order])
}

// The hard rule as a constraint: source_id is required, never nullable.
model Figure {
  id        String        @id
  partId    String        @map("part_id")
  part      ExplainerPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  label     String
  value     String
  unit      String
  period    String
  sourceId  String        @map("source_id")
  source    Source        @relation(fields: [sourceId], references: [id])
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([partId])
}

model Source {
  id        String   @id
  title     String
  docType   String   @map("doc_type")
  period    String
  url       String?
  fileRef   String?  @map("file_ref")
  figures   Figure[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model QuizQuestion {
  id          String    @id
  explainerId String    @map("explainer_id")
  explainer   Explainer @relation(fields: [explainerId], references: [id], onDelete: Cascade)
  order       Int
  partKind    String    @map("part_kind")
  prompt      String
  correctIdx  Int       @map("correct_idx")
  options     String // JSON array of strings
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([explainerId, order])
}

// Pro entitlement, set by Dodo Payments webhooks and keyed by the account email.
model ProSubscription {
  id                 String   @id @default(cuid())
  email              String   @unique
  status             String // active | renewed | on_hold | cancelled | expired
  dodoSubscriptionId String?  @map("dodo_subscription_id")
  dodoCustomerId     String?  @map("dodo_customer_id")
  currentPeriodEnd   DateTime? @map("current_period_end")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
}

// Server-side Pro progress: one row when a signed-in user finishes a company
// (watches the explainer and attempts its quiz). Source of truth for tracks.
model Completion {
  id          String   @id @default(cuid())
  email       String
  companySlug String   @map("company_slug")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([email, companySlug])
  @@index([email])
}

// Signed-in user progress, keyed by email — mirrors the on-device cache in
// src/lib/progress.ts so a member's notes, quizzes and streak follow them
// across devices. The device keeps its own copy and works offline.
model ProgressNote {
  id          String   @id @default(cuid())
  email       String
  explainerId String   @map("explainer_id")
  slug        String
  text30w     String   @map("text_30w")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([email, explainerId])
  @@index([email])
}

model ProgressQuiz {
  id          String   @id @default(cuid())
  email       String
  explainerId String   @map("explainer_id")
  slug        String
  score       Int
  answers     Int[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([email])
}

model ProgressStreak {
  email          String  @id
  currentLen     Int     @default(0) @map("current_len")
  longestLen     Int     @default(0) @map("longest_len")
  lastActiveDate String? @map("last_active_date")
}

model ProgressIndustry {
  id              String @id @default(cuid())
  email           String
  industrySlug    String @map("industry_slug")
  explainersDone  Int    @default(0) @map("explainers_done")
  totalAtSnapshot Int    @default(0) @map("total_at_snapshot")

  @@unique([email, industrySlug])
  @@index([email])
}

// A Pro track: a themed, ordered list of companies. kind = sector | interview_kit.
model Track {
  id           String      @id
  slug         String      @unique
  name         String
  blurb        String?
  kind         String
  industrySlug String?     @map("industry_slug")
  isPro        Boolean     @default(true) @map("is_pro")
  order        Int         @default(0)
  items        TrackItem[]
}

model TrackItem {
  id          String @id
  trackId     String @map("track_id")
  track       Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  companySlug String @map("company_slug")
  order       Int

  @@unique([trackId, companySlug])
  @@index([trackId])
}

// Issued when a Pro user completes every company in a track.
model Certificate {
  id        String   @id @default(cuid())
  email     String
  trackSlug String   @map("track_slug")
  name      String?
  attests   String   @default("track_completion")
  issuedAt  DateTime @default(now()) @map("issued_at")

  @@unique([email, trackSlug])
}
