# Local dev and production both use your Supabase Postgres.
# DATABASE_URL: the pooled "Transaction" connection string (port 6543) + ?pgbouncer=true
# DIRECT_URL:   the direct connection string (port 5432), used for db push / seed
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your anon public key>
