{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "anant-dev",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "PATH=$HOME/.local/node/bin:$PATH exec npm run dev"],
      "port": 3000
    },
    {
      "name": "anant-prod",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "PATH=$HOME/.local/node/bin:$PATH exec npm run start -- -p 3100"],
      "port": 3100
    }
  ]
}
